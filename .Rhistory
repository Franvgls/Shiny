pkg_dir <- "D:/FVG/GithubRs/NeAtlIBTS64/R"
pkg_R   <- list.files(pkg_dir, "\\.R$", full.names = TRUE)
for (f in pkg_R) {
src <- readLines(f, warn = FALSE)
# localizar el inicio de cada llamada a IBTSNeAtl_map64
starts <- grep("IBTSNeAtl_map64\\s*\\(", src)
for (s in starts) {
# juntar hasta 30 líneas para capturar llamadas multilínea
end <- min(s + 30, length(src))
block <- paste(src[s:end], collapse = " ")
# cortar en el paréntesis de cierre (heurística razonable)
block <- sub("\\).*$", ")", block)
old_api <- grepl("\\b(sl|nl|wl|el)\\s*=", block)
new_api <- grepl("\\b(xlims|ylims)\\s*=", block)
tag <- if (old_api && !new_api) "❌ VIEJA"
else if (old_api &&  new_api)  "⚠️  MIXTA"
else if (!old_api && new_api) "✅ NUEVA"
else                           "·  sin lims"
cat(sprintf("%s  %s:%d\n   %s\n\n",
tag, basename(f), s,
substr(block, 1, 180)))
}
}
