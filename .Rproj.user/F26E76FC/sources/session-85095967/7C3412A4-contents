# ============================================================
# CHECK SOLEA SOLEA IN ICES DATRAS: SP-NORTH
# - Verify whether SP-NORTH exists
# - Check whether Solea solea (AphiaID 127160) is present
# - Check whether year 2025 is available
# - List all available years / quarters
# - Extract haul-level lat, lon, presence-absence, abundance
# ============================================================

# -----------------------------
# 0) Packages
# -----------------------------
required_pkgs <- c("icesDatras", "dplyr", "purrr", "tidyr", "stringr", "readr")

to_install <- required_pkgs[!sapply(required_pkgs, requireNamespace, quietly = TRUE)]
if (length(to_install) > 0) {
  install.packages(to_install)
}

library(icesDatras)
library(dplyr)
library(purrr)
library(tidyr)
library(stringr)
library(readr)

# -----------------------------
# 1) User settings
# -----------------------------
survey       <- "SP-NORTH"
target_quarters <- c(3, 4)    #####<- no hay q3, la campaña SP-NORTH tiene es de cuarto
                      ##trimestre, aunque tenga algunos lances en q3 se consideran Q4 la totalidad de la campaña
target_aphia <- 127160
target_name  <- "Solea solea"

# Optional: set output folder
out_dir <- "output_sp_north_solea"
if (!dir.exists(out_dir)) dir.create(out_dir, recursive = TRUE)

# -----------------------------
# 2) Helper functions
# -----------------------------

safe_get_year_quarters <- function(survey, year) {
  tryCatch(
    getSurveyYearQuarterList(survey = survey, year = year),
    error = function(e) NA
  )
}

safe_get_hh <- function(survey, year, quarter) {
  tryCatch(
    getHHdata(survey = survey, year = year, quarter = quarter),
    error = function(e) NULL
  )
}

safe_get_hl <- function(survey, year, quarter) {
  tryCatch(
    getHLdata(survey = survey, year = year, quarter = quarter),
    error = function(e) NULL
  )
}

find_col <- function(df, candidates) {
  hit <- intersect(candidates, names(df))
  if (length(hit) == 0) return(NA_character_)
  hit[1]
}

# Standardize haul id columns that usually exist in DATRAS HH/HL
get_haul_key_cols <- function(df) {
  possible <- c("Survey", "Year", "Quarter", "Country", "Ship", "Gear", "HaulNo")
  intersect(possible, names(df))
}

# Extract a best-guess abundance column from HL
# Priority:
# 1) NumberAtLength-like columns if present
# 2) HLNoAtLngt-like columns if present
# 3) Subsample-adjusted numbers if present
guess_abundance_col <- function(df) {
  candidates <- c(
    "N", "Number", "NumberAtLength", "NoAtLngt", "HLNoAtLngt",
    "TotalNo", "TotNo", "Numbers", "SpecimenNo"
  )
  hit <- intersect(candidates, names(df))
  if (length(hit) > 0) return(hit[1])

  # fallback: fuzzy search
  fuzzy <- names(df)[str_detect(names(df), regex("no|number|abund|lngt", ignore_case = TRUE))]
  if (length(fuzzy) > 0) return(fuzzy[1])

  return(NA_character_)
}

# Build a best-guess latitude/longitude from HH
guess_lat_lon_cols <- function(df) {
  lat_col <- find_col(df, c("ShootLat", "HaulLat", "StatLat", "Latitude", "Lat"))
  lon_col <- find_col(df, c("ShootLong", "HaulLong", "StatLong", "Longitude", "Lon", "Long"))
  list(lat = lat_col, lon = lon_col)
}

# -----------------------------
# 3) Verify survey exists
# -----------------------------
all_surveys <- tryCatch(getSurveyList(), error = function(e) NULL)

if (is.null(all_surveys)) {
  stop("Could not retrieve survey list from DATRAS.")
}

if (is.data.frame(all_surveys) && "Survey" %in% names(all_surveys)) {
  survey_values <- unique(all_surveys$Survey)
} else {
  survey_values <- unique(as.character(all_surveys))
}

cat("Survey found in DATRAS?: ", survey %in% survey_values, "\n")

if (!(survey %in% survey_values)) {
  stop(sprintf("Survey '%s' was not found in DATRAS.", survey))
}

# -----------------------------
# 4) Available years for survey
# -----------------------------
years_available <- tryCatch(getSurveyYearList(survey = survey), error = function(e) NULL)

if (is.null(years_available) || length(years_available) == 0) {
  stop(sprintf("No years returned for survey '%s'.", survey))
}

years_available <- sort(unique(as.integer(years_available)))

cat("\nAvailable years for", survey, ":\n")
print(years_available)

cat("\nIs 2025 available?: ", 2025 %in% years_available, "\n")

# Save years
write_csv(
  tibble(survey = survey, year = years_available),
  file.path(out_dir, "sp_north_available_years.csv")
)

# -----------------------------
# 5) Available quarters by year
# -----------------------------
quarters_by_year <- map_dfr(
  years_available,
  function(y) {
    qs <- safe_get_year_quarters(survey, y)

    if (all(is.na(qs))) {
      tibble(year = y, quarter = NA_integer_)
    } else {
      tibble(year = y, quarter = as.integer(qs))
    }
  }
)

cat("\nAvailable quarters by year:\n")
print(quarters_by_year, n = nrow(quarters_by_year))

write_csv(
  quarters_by_year,
  file.path(out_dir, "sp_north_available_quarters_by_year.csv")
)

# -----------------------------
# 6) Keep all year-quarter combinations of interest
# -----------------------------
year_quarter_use <- quarters_by_year %>%
  filter(quarter %in% target_quarters) %>%
  distinct(year, quarter) %>%
  arrange(year, quarter)

cat("\nYear-quarter combinations available for survey", survey, ":\n")
print(year_quarter_use, n = nrow(year_quarter_use))

if (nrow(year_quarter_use) == 0) {
  stop(sprintf("No data found for survey '%s' in quarters %s.",
               survey,
               paste(target_quarters, collapse = ", ")))
}

# -----------------------------
# 7) Download HH and HL for all selected year-quarter combinations
# -----------------------------
hh_list <- purrr::map2(
  year_quarter_use$year,
  year_quarter_use$quarter,
  ~ safe_get_hh(survey, .x, .y)
)

hl_list <- purrr::map2(
  year_quarter_use$year,
  year_quarter_use$quarter,
  ~ safe_get_hl(survey, .x, .y)
)

hh_all <- dplyr::bind_rows(hh_list)
hl_all <- dplyr::bind_rows(hl_list)

if (nrow(hh_all) == 0) stop("HH data could not be downloaded.")
if (nrow(hl_all) == 0) stop("HL data could not be downloaded.")

# -----------------------------
# 8) Check HL columns and filter Solea solea
# -----------------------------
cat("\nHL columns:\n")
print(names(hl_all))

aphia_col_hl <- find_col(hl_all, c("AphiaID", "Valid_AphiaID", "Aphia"))
if (is.na(aphia_col_hl)) {
  stop("Could not find an AphiaID column in HL data.")
}

hl_solea <- hl_all %>%
  filter(.data[[aphia_col_hl]] == target_aphia)

cat("\nNumber of HL rows for target species:\n")
print(nrow(hl_solea))

cat("\nYears where target species appears in HL:\n")
years_species <- sort(unique(as.integer(hl_solea$Year)))
print(years_species)

write_csv(
  hl_solea,
  file.path(out_dir, "HL_sp_north_q3_q4_solea_solea.csv")
)

# If no rows, stop with a clean message
if (nrow(hl_solea) == 0) {
  message("\nNo HL records found for Solea solea (AphiaID 127160) in SP-NORTH, Q3/Q4.")
  message("Check whether the survey, year-quarter combinations, or species occurrence are appropriate.")
  quit(save = "no")
}

# -----------------------------
# 9) Build haul-level abundance from HL
# -----------------------------
haul_key_cols_hl <- get_haul_key_cols(hl_solea)
abundance_col <- guess_abundance_col(hl_solea)

cat("\nDetected abundance column in HL:\n")
print(abundance_col)

if (is.na(abundance_col)) {
  stop("Could not identify a suitable abundance column in HL.")
}

hl_solea_haul <- hl_solea %>%
  mutate(abundance_value = suppressWarnings(as.numeric(.data[[abundance_col]]))) %>%
  group_by(across(all_of(haul_key_cols_hl))) %>%
  summarise(
    abundance = sum(abundance_value, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(presence = as.integer(abundance > 0))

cat("\nHauls with Solea solea:\n")
print(nrow(hl_solea_haul))

write_csv(
  hl_solea_haul,
  file.path(out_dir, "haul_level_abundance_sp_north_q3_q4_solea.csv")
)

# -----------------------------
# 10) Prepare HH haul positions
# -----------------------------
cat("\nHH columns:\n")
print(names(hh_all))

haul_key_cols_hh <- get_haul_key_cols(hh_all)
latlon <- guess_lat_lon_cols(hh_all)

if (is.na(latlon$lat) || is.na(latlon$lon)) {
  stop("Could not identify latitude/longitude columns in HH.")
}

hh_hauls <- hh_all %>%
  select(all_of(unique(c(haul_key_cols_hh, latlon$lat, latlon$lon)))) %>%
  distinct()

# -----------------------------
# 11) Create full haul table with absences
# -----------------------------
# Join all HH hauls with species abundance.
# Hauls with no Solea in HL become abundance = 0 and presence = 0.

join_keys <- intersect(haul_key_cols_hh, haul_key_cols_hl)

sdm_table <- hh_hauls %>%
  left_join(hl_solea_haul, by = join_keys) %>%
  mutate(
    abundance = ifelse(is.na(abundance), 0, abundance),
    presence  = ifelse(is.na(presence), 0L, presence),
    species   = target_name,
    AphiaID   = target_aphia
  ) %>%
  rename(
    lat = !!latlon$lat,
    lon = !!latlon$lon
  ) %>%
  arrange(Year, Quarter, HaulNo)

# -----------------------------
# 12) Summary outputs
# -----------------------------
cat("\nSummary by year:\n")
summary_year <- sdm_table %>%
  group_by(Year) %>%
  summarise(
    n_hauls = n(),
    n_presences = sum(presence, na.rm = TRUE),
    prevalence = mean(presence, na.rm = TRUE),
    total_abundance = sum(abundance, na.rm = TRUE),
    .groups = "drop"
  )

print(summary_year, n = nrow(summary_year))

write_csv(
  summary_year,
  file.path(out_dir, "summary_by_year_sp_north_q3_q4_solea.csv")
)

# Optional: summary by year and quarter
summary_year_quarter <- sdm_table %>%
  group_by(Year, Quarter) %>%
  summarise(
    n_hauls = n(),
    n_presences = sum(presence, na.rm = TRUE),
    prevalence = mean(presence, na.rm = TRUE),
    total_abundance = sum(abundance, na.rm = TRUE),
    .groups = "drop"
  )

write_csv(
  summary_year_quarter,
  file.path(out_dir, "summary_by_year_quarter_sp_north_q3_q4_solea.csv")
)

# -----------------------------
# 13) Save final SDM-ready table
# -----------------------------
sdm_export <- sdm_table %>%
  select(
    Survey, Year, Quarter, Country, Ship, Gear, HaulNo,
    lat, lon, presence, abundance, species, AphiaID
  )

write_csv(
  sdm_export,
  file.path(out_dir, "sdm_ready_sp_north_q3_q4_solea_presence_absence_abundance.csv")
)

cat("\nDone.\n")
cat("Main output file:\n")
cat(file.path(out_dir, "sdm_ready_sp_north_q3_q4_solea_presence_absence_abundance.csv"), "\n")

